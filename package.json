{
  "name": "@ryux1/mcp-trace",
  "version": "0.2.0",
  "description": "Security-first Model Context Protocol observability gateway for Streamable HTTP recording, inspection, tracing, and replay.",
  "type": "module",
  "license": "MIT",
  "author": "Ryu <code@ryux1.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryux1/mcp-trace.git"
  },
  "bugs": {
    "url": "https://github.com/ryux1/mcp-trace/issues"
  },
  "homepage": "https://ryux1.github.io/mcp-trace/",
  "keywords": [
    "developer-tools",
    "json-rpc",
    "mcp",
    "mcp-observability",
    "mcp-proxy",
    "model-context-protocol",
    "observability",
    "opentelemetry",
    "prometheus",
    "proxy",
    "record-replay",
    "security",
    "streamable-http",
    "tracing"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.0",
  "bin": {
    "mcp-trace": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/*.md",
    "docs/assets/demo-output.svg",
    "docs/benchmark-results/*.json"
  ],
  "scripts": {
    "benchmark": "pnpm build && node benchmark/benchmark.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "demo": "pnpm build && node examples/run-demo.mjs",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
